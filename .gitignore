# secrets / env
.env
.env.local
*.key
credentials.json

# personal/local Claude Code permissions (never commit; per-machine)
.claude/settings.local.json

# state / runtime (ledger is in Postgres now; runs are local artifacts)
state/runs/
state/.APPROVED_*
state/.ARCHIVE_EMBED_APPROVED
*.log

# P23 weekly Notion delivery — runtime state (per-machine; never commit)
state/.P23_ENABLED
state/.cron_p23.lock
state/p23_last_run_week
state/p23_last_present_day

# P13 archive dry-run artifacts (regenerable from --apply pipeline)
state/archive/*.jsonl
state/archive/*.json
state/archive/_tmp/
state/archive/queues/
state/archive/queues_p28/
state/archive/profiles/
state/archive/discovery_run/
state/archive/synopses/

# P15: taxonomy moved into plugin/data/taxonomy.json (ships with marketplace
# install). state/archive/ now only contains regenerable dry-run artifacts,
# so no exception is needed here.

# P15: plugin-side temp dir the SKILL writes for @file JSON passing
plugin/state/

# P19a: per-researcher fingerprints are regenerable from csnl_research +
# the lexicon. Operator can `! python scripts/archive/build_fingerprints.py
# --apply` to refresh. Keep out of git so they don't leak project details
# from researchers who haven't approved exposure.
state/archive/fingerprints/

# caches
__pycache__/
*.pyc
.DS_Store
*.anchor-vectors.json
.embed-cache/

# node (playwright/pdfjs crawl stack)
node_modules/
state/archive/surveys/

# P31 GRM cron runtime state (per-machine; never commit — mirrors P23 runtime)
state/.GRM_INGEST_ENABLED
state/grm_last_run_week

# P32 dead-table quarantine backups (local reversibility artifact — parity dumps)
state/archive/_backup_p32/

# P33: guard against stray 0-byte shell-accident files at repo root
# (e.g. a heredoc/redirect typo creating files named '#', 'the', 'token', …)
/\#
/enable
/soft
/the
/token

# P34 autonomous exploration records (raw; distilled output lands in docs/)
state/archive/_explore/
