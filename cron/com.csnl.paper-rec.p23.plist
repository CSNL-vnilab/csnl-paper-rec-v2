<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.csnl.paper-rec.p23</string>

  <!-- Fire every 30 minutes (at :00 and :30 of every hour, every day).
       The shell wrapper self-routes by KST day/hour:
         Mon 09:00 build+send · Sun 18:00 expire · Sun 09:00 preview ·
         every other tick → capture_responses.
       TZ=Asia/Seoul forces KST so the :00 ticks line up with the KST hours. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/csnl/Documents/claude/csnl-paper-rec</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/csnl/Documents/claude/csnl-paper-rec/scripts/weekly/run_weekly_cron.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Seoul</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/csnl/Documents/claude/csnl-paper-rec/state/cron-p23.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/csnl/Documents/claude/csnl-paper-rec/state/cron-p23.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
